<Window x:Class="ScreenRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenGank" Width="1140" Height="820" MinWidth="1000" MinHeight="640"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Capture settings ===== -->
        <Border Style="{StaticResource Card}" Padding="12,10">
            <WrapPanel x:Name="CapturePanel" VerticalAlignment="Center">
                <!-- Each label stays on the same line as its control when the row wraps. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                    <TextBlock Style="{StaticResource Label}" Text="Capture"/>
                    <ComboBox x:Name="CaptureCombo" Width="290" SelectionChanged="OnCaptureModeChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Style="{StaticResource Label}" Text="Size"/>
                    <ComboBox x:Name="SizeCombo" Width="150" SelectionChanged="OnSizePresetChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Style="{StaticResource Label}" Text="Frame rate"/>
                    <ComboBox x:Name="FpsCombo" Width="80">
                        <ComboBoxItem Content="30 fps" Tag="30" IsSelected="True"/>
                        <ComboBoxItem Content="60 fps" Tag="60"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Label}" Text="Audio source"/>
                    <ComboBox x:Name="AudioCombo" Width="360" Margin="0,0,6,0"
                              ToolTip="System sound records what plays on that device. Pick a microphone, or system sound plus a microphone, to record your voice."/>
                    <Button Content="↻" Width="32" ToolTip="Refresh devices and displays" Click="OnRefreshDevices"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                    <CheckBox x:Name="AutoSaveCheck" Content="Autosave after Stop" Margin="16,0,0,0" VerticalAlignment="Center"
                              Checked="OnAutoSaveChanged" Unchecked="OnAutoSaveChanged"
                              ToolTip="Save every recording to Videos\ScreenGank when you stop. When off, the clip opens here unsaved: export it to keep it."/>
                    <CheckBox x:Name="MinimizeCheck" Content="Minimize while recording" IsChecked="True" Margin="16,0,0,0"
                              VerticalAlignment="Center" ToolTip="Hide this window while recording. Use the floating bar or hotkeys to pause and stop."/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===== Preview ===== -->
        <Border Grid.Row="1" Margin="0,10" CornerRadius="8" Background="#111318" ClipToBounds="True">
            <Grid>
                <Viewbox x:Name="PreviewBox" Stretch="Uniform" Visibility="Collapsed">
                    <Grid x:Name="VideoHost" Width="1280" Height="720">
                        <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                      Stretch="Fill" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                    </Grid>
                </Viewbox>

                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Foreground="#E5E7EB" FontSize="18" HorizontalAlignment="Center"
                               Text="Place the frame over what you want to record, then press Record."/>
                    <TextBlock Foreground="#9CA3AF" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Text="Autosaved clips are stored at Videos\ScreenGank. All completed recordings will open here for export and editing."/>
                </StackPanel>

                <Border x:Name="RecBadge" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#CC111827" CornerRadius="10" Padding="22,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecDot" Width="22" Height="22" Fill="{StaticResource RecordRed}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecBadgeText" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="14,0,0,0"
                                   Text="REC 00:00:00" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Timeline + transport ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Text="0:00.0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                    <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="OnTimelineChanged" IsEnabled="False"/>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00.0" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimerText" FontSize="20" FontWeight="SemiBold" Text="00:00:00"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="13" Margin="6,6,0,0" Text="/ 2:00:00 max"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RecordButton" Style="{StaticResource TransportButton}" Width="56" Height="56" Margin="0,0,18,0"
                                ToolTip="Record (3-second countdown)" Click="OnRecord" Background="White">
                            <Ellipse Width="22" Height="22" Fill="{StaticResource RecordRed}"/>
                        </Button>
                        <Button x:Name="StartButton" Style="{StaticResource TransportButton}" ToolTip="Jump to clip start" Click="OnJumpStart">
                            <Path Style="{StaticResource Icon}" Data="M0,0 H2.5 V12 H0 Z M12,0 L3.5,6 L12,12 Z"/>
                        </Button>
                        <RepeatButton x:Name="RewindButton" Style="{StaticResource TransportButton}" ToolTip="Rewind 5 seconds (hold to scan)"
                                      Delay="400" Interval="150" Click="OnRewind">
                            <Path Style="{StaticResource Icon}" Data="M14,0 L7,6 L14,12 Z M7,0 L0,6 L7,12 Z"/>
                        </RepeatButton>
                        <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" ToolTip="Play" Click="OnPlay">
                            <Path Style="{StaticResource Icon}" Data="M0,0 L10,6 L0,12 Z" Margin="3,0,0,0"/>
                        </Button>
                        <Button x:Name="PauseButton" Style="{StaticResource TransportButton}" ToolTip="Pause / resume" Click="OnPause">
                            <Path Style="{StaticResource Icon}" Data="M0,0 H3.5 V12 H0 Z M6.5,0 H10 V12 H6.5 Z"/>
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource TransportButton}" ToolTip="Stop" Click="OnStop">
                            <Path Style="{StaticResource Icon}" Data="M0,0 H10 V10 H0 Z" Width="14" Height="14"/>
                        </Button>
                        <RepeatButton x:Name="ForwardButton" Style="{StaticResource TransportButton}" ToolTip="Fast-forward 5 seconds (hold to scan)"
                                      Delay="400" Interval="150" Click="OnForward">
                            <Path Style="{StaticResource Icon}" Data="M0,0 L7,6 L0,12 Z M7,0 L14,6 L7,12 Z"/>
                        </RepeatButton>
                        <Button x:Name="EndButton" Style="{StaticResource TransportButton}" ToolTip="Jump to clip end" Click="OnJumpEnd">
                            <Path Style="{StaticResource Icon}" Data="M0,0 L8.5,6 L0,12 Z M9.5,0 H12 V12 H9.5 Z"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}" Text="Ready"/>
                    </StackPanel>
                </Grid>

                <!-- Own row so it never runs under the transport buttons in a narrow window. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock x:Name="HotkeyText" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    <Button Content="Change hotkeys…" FontSize="11" Padding="6,1" Margin="8,0,0,0" Click="OnChangeHotkeys"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Export ===== -->
        <Border Grid.Row="3" Margin="0,10,0,0" x:Name="EditPanel" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Export"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FmtMp4" Content="MP4" IsChecked="True" Margin="0,0,14,0" Checked="OnFormatChanged"/>
                        <RadioButton x:Name="FmtMkv" Content="MKV" Margin="0,0,14,0" Checked="OnFormatChanged"/>
                        <RadioButton x:Name="FmtGif" Content="GIF" Checked="OnFormatChanged"/>
                    </StackPanel>

                    <!-- MP4 / MKV: file size -->
                    <Grid x:Name="SizeOptions" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="File size"/>
                        <Slider x:Name="FileSizeSlider" Grid.Column="1" Minimum="25" Maximum="100" Value="100" VerticalAlignment="Center"
                                SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="False"
                                ValueChanged="OnFileSizeChanged"/>
                        <TextBlock x:Name="FileSizeText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="Original size" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <TextBlock x:Name="FileSizeHint" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Move slider to adjust export file size. Minimum size is capped to prevent poor quality."/>

                    <!-- GIF -->
                    <Grid x:Name="GifOptions" Margin="0,10,0,0" Visibility="Collapsed" HorizontalAlignment="Left" Width="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Width"/>
                        <ComboBox x:Name="GifWidthCombo" Grid.Column="1" Margin="0,0,8,0">
                            <ComboBoxItem Content="320 px" Tag="320"/>
                            <ComboBoxItem Content="480 px" Tag="480"/>
                            <ComboBoxItem Content="640 px" Tag="640" IsSelected="True"/>
                            <ComboBoxItem Content="800 px" Tag="800"/>
                            <ComboBoxItem Content="1280 px" Tag="1280"/>
                            <ComboBoxItem Content="Original" Tag="0"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="FPS"/>
                        <ComboBox x:Name="GifFpsCombo" Grid.Column="3">
                            <ComboBoxItem Content="10" Tag="10"/>
                            <ComboBoxItem Content="15" Tag="15" IsSelected="True"/>
                            <ComboBoxItem Content="20" Tag="20"/>
                            <ComboBoxItem Content="25" Tag="25"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="GifHint" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed" Text="GIFs are up to 15 seconds. Longer clips start from the playhead."/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Content="Export…" Padding="10,7"
                            Click="OnExport" ToolTip="Save the clip in this format"/>
                    <Button x:Name="EditorButton" Content="Open in editor…" Margin="0,6,0,0" Padding="10,6" Click="OnOpenEditor"
                            ToolTip="Trim, crop, resize and add text before saving"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ExportProgress" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                        <Button x:Name="CancelExportButton" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" IsEnabled="False"
                                Click="OnCancelExport"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Open video…" Margin="0,0,6,0" Click="OnOpenVideo"/>
                        <Button x:Name="ShowFolderButton" Content="Show in folder" Click="OnShowFolder"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
