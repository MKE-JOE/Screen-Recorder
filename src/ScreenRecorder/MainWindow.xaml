<Window x:Class="ScreenRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ScreenRecorder.Controls"
        Title="Screen Recorder" Width="1140" Height="820" MinWidth="1000" MinHeight="700"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Capture settings ===== -->
        <Border Style="{StaticResource Card}" Padding="12,10">
            <WrapPanel x:Name="CapturePanel" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="Capture"/>
                <ComboBox x:Name="CaptureCombo" Width="290" Margin="0,0,10,4" SelectionChanged="OnCaptureModeChanged"/>
                <TextBlock Style="{StaticResource Label}" Text="Size"/>
                <ComboBox x:Name="SizeCombo" Width="150" Margin="0,0,16,4" SelectionChanged="OnSizePresetChanged"/>
                <TextBlock Style="{StaticResource Label}" Text="Frame rate"/>
                <ComboBox x:Name="FpsCombo" Width="80" Margin="0,0,16,4">
                    <ComboBoxItem Content="30 fps" Tag="30" IsSelected="True"/>
                    <ComboBoxItem Content="60 fps" Tag="60"/>
                </ComboBox>
                <TextBlock Style="{StaticResource Label}" Text="Audio"/>
                <ComboBox x:Name="AudioCombo" Width="240" Margin="0,0,10,4" ToolTip="Sound playing on this device is recorded"/>
                <TextBlock Style="{StaticResource Label}" Text="Mic"/>
                <ComboBox x:Name="MicCombo" Width="190" Margin="0,0,6,4"/>
                <Button Content="↻" Width="32" Margin="0,0,0,4" ToolTip="Refresh devices and displays" Click="OnRefreshDevices"/>
                <CheckBox x:Name="MinimizeCheck" Content="Minimize while recording" IsChecked="True" Margin="16,0,0,4"
                          VerticalAlignment="Center" ToolTip="Hide this window while recording. Use the floating bar or hotkeys to pause and stop."/>
            </WrapPanel>
        </Border>

        <!-- ===== Preview ===== -->
        <Border Grid.Row="1" Margin="0,10" CornerRadius="8" Background="#111318" ClipToBounds="True">
            <Grid>
                <Viewbox x:Name="PreviewBox" Stretch="Uniform" Visibility="Collapsed">
                    <Grid x:Name="VideoHost" Width="1280" Height="720">
                        <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                      Stretch="Fill" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed"/>
                        <Canvas x:Name="OverlayCanvas" ClipToBounds="True">
                            <c:OutlinedText x:Name="OverlayText" Cursor="SizeAll" Visibility="Collapsed"
                                            MouseLeftButtonDown="OnOverlayMouseDown" MouseMove="OnOverlayMouseMove"
                                            MouseLeftButtonUp="OnOverlayMouseUp"/>
                        </Canvas>
                    </Grid>
                </Viewbox>

                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Foreground="#E5E7EB" FontSize="18" HorizontalAlignment="Center"
                               Text="Place the frame over what you want to record, then press Record."/>
                    <TextBlock Foreground="#9CA3AF" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Text="Recordings are saved to Videos\Screen Recorder and open here for trimming and export."/>
                </StackPanel>

                <Border x:Name="RecBadge" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#CC111827" CornerRadius="10" Padding="22,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecDot" Width="22" Height="22" Fill="{StaticResource RecordRed}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecBadgeText" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="14,0,0,0"
                                   Text="REC 00:00:00" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Timeline + transport ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Text="0:00.0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                    <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            IsSelectionRangeEnabled="True" SelectionStart="0" SelectionEnd="1" VerticalAlignment="Center"
                            ValueChanged="OnTimelineChanged" IsEnabled="False"/>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00.0" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimerText" FontSize="20" FontWeight="SemiBold" Text="00:00:00"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="13" Margin="6,6,0,0" Text="/ 2:00:00 max"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="RecordButton" Style="{StaticResource TransportButton}" Width="56" Height="56" Margin="0,0,18,0"
                                ToolTip="Record (3-second countdown)" Click="OnRecord" Background="White">
                            <Ellipse Width="22" Height="22" Fill="{StaticResource RecordRed}"/>
                        </Button>
                        <RepeatButton x:Name="RewindButton" Style="{StaticResource TransportButton}" ToolTip="Rewind 5 seconds (hold to scan)"
                                      Delay="400" Interval="150" Click="OnRewind">
                            <Path Style="{StaticResource Icon}" Data="M14,0 L7,6 L14,12 Z M7,0 L0,6 L7,12 Z"/>
                        </RepeatButton>
                        <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" ToolTip="Play" Click="OnPlay">
                            <Path Style="{StaticResource Icon}" Data="M0,0 L10,6 L0,12 Z" Margin="3,0,0,0"/>
                        </Button>
                        <Button x:Name="PauseButton" Style="{StaticResource TransportButton}" ToolTip="Pause / resume" Click="OnPause">
                            <Path Style="{StaticResource Icon}" Data="M0,0 H3.5 V12 H0 Z M6.5,0 H10 V12 H6.5 Z"/>
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource TransportButton}" ToolTip="Stop" Click="OnStop">
                            <Path Style="{StaticResource Icon}" Data="M0,0 H10 V10 H0 Z" Width="14" Height="14"/>
                        </Button>
                        <RepeatButton x:Name="ForwardButton" Style="{StaticResource TransportButton}" ToolTip="Fast-forward 5 seconds (hold to scan)"
                                      Delay="400" Interval="150" Click="OnForward">
                            <Path Style="{StaticResource Icon}" Data="M0,0 L7,6 L0,12 Z M7,0 L14,6 L7,12 Z"/>
                        </RepeatButton>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Text="Ready"/>
                        <TextBlock x:Name="HotkeyText" HorizontalAlignment="Right" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Edit / text / export ===== -->
        <Grid Grid.Row="3" Margin="0,10,0,0" x:Name="EditPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Trim -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Trim"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Start"/>
                        <TextBlock x:Name="TrimStartText" Grid.Column="1" Text="0:00.0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Set start here" Click="OnSetTrimStart"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="End"/>
                        <TextBlock x:Name="TrimEndText" Grid.Row="2" Grid.Column="1" Text="0:00.0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="Set end here" Click="OnSetTrimEnd"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Length"/>
                        <TextBlock x:Name="TrimLengthText" Grid.Row="4" Grid.Column="1" Text="0:00.0" VerticalAlignment="Center"/>
                        <Button Grid.Row="4" Grid.Column="2" Content="Reset" Click="OnResetTrim"/>
                    </Grid>
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Move the playhead, then set where the clip starts and ends. The shaded part of the timeline is kept."/>
                </StackPanel>
            </Border>

            <!-- Text overlay -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Add text (for GIFs)"/>
                    <TextBox x:Name="OverlayInput" Height="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Padding="4" TextChanged="OnOverlayChanged"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Font"/>
                        <ComboBox x:Name="FontCombo" Grid.Column="1" Margin="0,0,10,0" SelectionChanged="OnOverlayChanged"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="Color"/>
                        <ComboBox x:Name="ColorCombo" Grid.Column="3" SelectionChanged="OnOverlayChanged"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Size"/>
                        <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="12" Maximum="240" Value="64" VerticalAlignment="Center"
                                ValueChanged="OnOverlayChanged"/>
                        <TextBlock x:Name="SizeValue" Grid.Column="2" Text="64" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <CheckBox x:Name="OutlineCheck" Grid.Column="3" Content="Outline" IsChecked="True" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"/>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Place"/>
                        <Button Content="Top" Margin="0,0,4,0" Tag="top" Click="OnOverlayPlace"/>
                        <Button Content="Middle" Margin="0,0,4,0" Tag="middle" Click="OnOverlayPlace"/>
                        <Button Content="Bottom" Margin="0,0,10,0" Tag="bottom" Click="OnOverlayPlace"/>
                        <CheckBox x:Name="CenterCheck" Content="Center horizontally" IsChecked="True" VerticalAlignment="Center"
                                  Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"/>
                    </WrapPanel>
                    <CheckBox x:Name="TextOnVideoCheck" Margin="0,8,0,0" Content="Also add the text to MP4 / MKV exports"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Drag the text on the preview to move it."/>
                </StackPanel>
            </Border>

            <!-- Export -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Export"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FmtMp4" Content="MP4" IsChecked="True" Margin="0,0,14,0" Checked="OnFormatChanged"/>
                        <RadioButton x:Name="FmtMkv" Content="MKV" Margin="0,0,14,0" Checked="OnFormatChanged"/>
                        <RadioButton x:Name="FmtGif" Content="GIF" Checked="OnFormatChanged"/>
                    </StackPanel>
                    <Grid x:Name="GifOptions" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Width"/>
                        <ComboBox x:Name="GifWidthCombo" Grid.Column="1" Margin="0,0,8,0">
                            <ComboBoxItem Content="320 px" Tag="320"/>
                            <ComboBoxItem Content="480 px" Tag="480"/>
                            <ComboBoxItem Content="640 px" Tag="640" IsSelected="True"/>
                            <ComboBoxItem Content="800 px" Tag="800"/>
                            <ComboBoxItem Content="1280 px" Tag="1280"/>
                            <ComboBoxItem Content="Original" Tag="0"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="FPS"/>
                        <ComboBox x:Name="GifFpsCombo" Grid.Column="3">
                            <ComboBoxItem Content="10" Tag="10"/>
                            <ComboBoxItem Content="15" Tag="15" IsSelected="True"/>
                            <ComboBoxItem Content="20" Tag="20"/>
                            <ComboBoxItem Content="25" Tag="25"/>
                        </ComboBox>
                    </Grid>
                    <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Content="Export…" Margin="0,10,0,0" Padding="10,7"
                            Click="OnExport"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ExportProgress" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                        <Button x:Name="CancelExportButton" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" IsEnabled="False"
                                Click="OnCancelExport"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Open video…" Margin="0,0,6,0" Click="OnOpenVideo"/>
                        <Button x:Name="ShowFolderButton" Content="Show in folder" Click="OnShowFolder"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
