<Window x:Class="ScreenRecorder.RegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture area" Width="840" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowActivated="False">
    <Window.Resources>
        <Style x:Key="EdgeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="#01FFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CornerThumb" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="#01FFFFFF">
                            <Rectangle Width="12" Height="12" Fill="White" Stroke="#2563EB" StrokeThickness="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Band around the capture area (outside what gets recorded): drag it to move, edges/corners resize. -->
        <Border x:Name="Band" BorderThickness="10" BorderBrush="#552563EB" MouseLeftButtonDown="OnDragMove">
            <!-- No background: the inside is click-through, so apps under the frame stay usable. -->
            <Border x:Name="CaptureArea">
                <Border x:Name="ToolPill" Background="#E6111827" CornerRadius="8" Padding="4"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#33FFFFFF" CornerRadius="5" Padding="8,3" Cursor="SizeAll"
                                    MouseLeftButtonDown="OnDragMove" ToolTip="Drag to move the frame">
                                <TextBlock Foreground="White" FontSize="12" Text="✥ Move"/>
                            </Border>
                            <TextBlock x:Name="SizeText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0" Text="1280 × 720"/>
                            <Button Content="Hide frame" Padding="8,3" FontSize="12" Click="OnHide"
                                    ToolTip="Hide this frame. The same area is still recorded. Show it again from the floating bar or with the hotkey."/>
                        </StackPanel>
                        <Border x:Name="InfoPill" Margin="4,5,4,1" IsHitTestVisible="False">
                            <TextBlock x:Name="HotkeysText" Foreground="#D1D5DB" FontSize="11" TextWrapping="Wrap" MaxWidth="420"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </Border>
        <Rectangle x:Name="Outline" Margin="7" Stroke="#2563EB" StrokeThickness="3" StrokeDashArray="3 2" IsHitTestVisible="False"/>

        <Grid x:Name="Handles">
            <Thumb Style="{StaticResource EdgeThumb}" Tag="L" Width="10" HorizontalAlignment="Left" Margin="0,20" Cursor="SizeWE" DragDelta="OnResize"/>
            <Thumb Style="{StaticResource EdgeThumb}" Tag="R" Width="10" HorizontalAlignment="Right" Margin="0,20" Cursor="SizeWE" DragDelta="OnResize"/>
            <Thumb Style="{StaticResource EdgeThumb}" Tag="T" Height="10" VerticalAlignment="Top" Margin="20,0" Cursor="SizeNS" DragDelta="OnResize"/>
            <Thumb Style="{StaticResource EdgeThumb}" Tag="B" Height="10" VerticalAlignment="Bottom" Margin="20,0" Cursor="SizeNS" DragDelta="OnResize"/>
            <Thumb Style="{StaticResource CornerThumb}" Tag="LT" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="OnResize"/>
            <Thumb Style="{StaticResource CornerThumb}" Tag="RT" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="OnResize"/>
            <Thumb Style="{StaticResource CornerThumb}" Tag="LB" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="OnResize"/>
            <Thumb Style="{StaticResource CornerThumb}" Tag="RB" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnResize"/>
        </Grid>
    </Grid>
</Window>
