<Window x:Class="ScreenRecorder.GifEditor.GifEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenRecorder.Controls"
        Title="GIF Editor" Width="1240" Height="840" MinWidth="1000" MinHeight="680"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" Icon="/Assets/app.ico">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static ApplicationCommands.Undo}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static ApplicationCommands.Redo}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}" Executed="OnUndo"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Redo}" Executed="OnRedo"/>
    </Window.CommandBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Frame tools ===== -->
        <Border Style="{StaticResource Card}" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LengthText" FontWeight="SemiBold" VerticalAlignment="Center" Text="0.0 s · 0 frames"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0" Text="(max 15 s)"/>
                </StackPanel>
                <WrapPanel x:Name="Tools">
                    <Button Content="↶ Undo" Margin="0,0,4,0" Click="OnUndo" ToolTip="Undo (Ctrl+Z)"/>
                    <Button Content="↷ Redo" Margin="0,0,12,0" Click="OnRedo" ToolTip="Redo (Ctrl+Y)"/>
                    <Button Content="Delete" Margin="0,0,4,0" Click="OnDelete" ToolTip="Delete the selected frames (Del)"/>
                    <Button Content="Duplicate" Margin="0,0,4,0" Click="OnDuplicate" ToolTip="Insert a copy of the selected frames"/>
                    <Button Content="◀ Move" Margin="0,0,4,0" Click="OnMoveLeft" ToolTip="Move the selected frames earlier"/>
                    <Button Content="Move ▶" Margin="0,0,12,0" Click="OnMoveRight" ToolTip="Move the selected frames later"/>
                    <Button Content="Reverse" Margin="0,0,4,0" Click="OnReverse" ToolTip="Play the selected frames (or all) backwards"/>
                    <Button Content="Boomerang" Margin="0,0,4,0" Click="OnBoomerang" ToolTip="Play forwards then backwards"/>
                    <Button Content="Reduce" Margin="0,0,12,0" Click="OnReduce" ToolTip="Remove every other frame (keeps the timing, halves the size)"/>
                    <Button Content="Slower" Margin="0,0,4,0" Click="OnSlower" ToolTip="Make the selected frames (or all) 25% slower"/>
                    <Button Content="Faster" Margin="0,0,12,0" Click="OnFaster" ToolTip="Make the selected frames (or all) 25% faster"/>
                    <TextBlock Style="{StaticResource Label}" Text="Delay"/>
                    <TextBox x:Name="DelayBox" Width="54" Padding="4,3" VerticalContentAlignment="Center" Text="70"/>
                    <TextBlock Style="{StaticResource Label}" Text="ms" Margin="4,0,6,0"/>
                    <Button Content="Set" Click="OnSetDelay" ToolTip="Show each selected frame for this long"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== Preview + side panel ===== -->
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border CornerRadius="8" Background="#2A2D33" ClipToBounds="True">
                    <Viewbox Stretch="Uniform" Margin="8">
                        <Grid x:Name="Stage" Width="640" Height="360">
                            <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Canvas x:Name="StageCanvas" ClipToBounds="True" Background="Transparent"
                                    MouseMove="OnStageMouseMove" MouseLeftButtonUp="OnStageMouseUp">
                                <Path x:Name="CropMask" Fill="#99000000" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <Border x:Name="CropBox" BorderBrush="White" BorderThickness="2" Background="#01FFFFFF"
                                        Cursor="SizeAll" Visibility="Collapsed" MouseLeftButtonDown="OnCropMouseDown"/>
                                <Thumb x:Name="CropHandle" Width="16" Height="16" Cursor="SizeNWSE" Visibility="Collapsed" Panel.ZIndex="3"
                                       DragDelta="OnCropResize">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="White" Stroke="#2563EB" StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb x:Name="BlurHandle" Width="16" Height="16" Cursor="SizeNWSE" Visibility="Collapsed" Panel.ZIndex="3"
                                       DragDelta="OnBlurResize">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="White" Stroke="#2563EB" StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FrameSlider" Margin="0,0,10,0" Minimum="0" Maximum="0" IsSnapToTickEnabled="True"
                                TickFrequency="1" SmallChange="1" LargeChange="5" VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="FrameText" Grid.Column="1" VerticalAlignment="Center" Text="Frame 0 / 0" MinWidth="110"/>
                    </Grid>
                    <controls:TransportControls x:Name="Transport" Margin="0,8,0,0" HorizontalAlignment="Center"
                                                JumpStart="OnJumpStart" Rewind="OnPrevFrame" Play="OnPlay" Pause="OnPause"
                                                Stop="OnStop" Forward="OnNextFrame" JumpEnd="OnJumpEnd"/>
                </StackPanel>
            </Grid>

            <!-- side panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="TextPanel">
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Remove" Click="OnRemoveLayer" Margin="4,0,0,0"/>
                                <Button DockPanel.Dock="Right" Content="+ Add text" Click="OnAddLayer"/>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Text="Text"/>
                            </DockPanel>
                            <ListBox x:Name="LayerList" Height="70" SelectionChanged="OnLayerSelected"/>
                            <StackPanel x:Name="LayerEditor" Margin="0,8,0,0" IsEnabled="False">
                                <TextBox x:Name="LayerText" Height="44" AcceptsReturn="True" TextWrapping="Wrap" Padding="4"
                                         TextChanged="OnLayerEdited"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="LayerFont" SelectionChanged="OnLayerEdited"/>
                                    <ComboBox x:Name="LayerColor" Grid.Column="2" SelectionChanged="OnLayerEdited"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="Size"/>
                                    <Slider x:Name="LayerSize" Grid.Column="1" Minimum="10" Maximum="200" Value="48" VerticalAlignment="Center"
                                            ValueChanged="OnLayerEdited"/>
                                    <TextBlock x:Name="LayerSizeText" Grid.Column="2" Text="48" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="LayerOutline" Grid.Column="3" Content="Outline" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Checked="OnLayerEdited" Unchecked="OnLayerEdited"/>
                                </Grid>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Top" Tag="top" Margin="0,0,4,0" Click="OnLayerPlace"/>
                                    <Button Content="Middle" Tag="middle" Margin="0,0,4,0" Click="OnLayerPlace"/>
                                    <Button Content="Bottom" Tag="bottom" Margin="0,0,8,0" Click="OnLayerPlace"/>
                                    <CheckBox x:Name="LayerCenter" Content="Center" VerticalAlignment="Center"
                                              Checked="OnLayerEdited" Unchecked="OnLayerEdited"/>
                                </WrapPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="From frame" Width="72"/>
                                    <TextBlock x:Name="LayerFromText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Button Grid.Column="2" Content="Set to current" Click="OnLayerFrom"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="To frame" Width="72"/>
                                    <TextBlock x:Name="LayerToText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="Set to current" Click="OnLayerTo"/>
                                </Grid>
                                <Button Content="Show on all frames" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnLayerAll"/>
                                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Drag the text on the preview to move it. Use frame ranges to make captions appear and disappear."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel x:Name="BlurPanel">
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="DoneBlurButton" DockPanel.Dock="Right" Content="Done" Click="OnBlurDone" Margin="4,0,0,0" IsEnabled="False"
                                        ToolTip="Hide the box outlines to review the blur as it will look in the saved GIF"/>
                                <Button DockPanel.Dock="Right" Content="Remove" Click="OnRemoveBlur" Margin="4,0,0,0"/>
                                <Button x:Name="AddBlurButton" DockPanel.Dock="Right" Content="+ Add blur" Click="OnAddBlur"/>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" Text="Blur"/>
                            </DockPanel>
                            <ListBox x:Name="BlurList" Height="64" SelectionChanged="OnBlurSelected"/>
                            <StackPanel x:Name="BlurEditor" Margin="0,8,0,0" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Text="From frame" Width="72"/>
                                    <TextBlock x:Name="BlurFromText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Button Grid.Column="2" Content="Set to current" Click="OnBlurFrom"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="To frame" Width="72"/>
                                    <TextBlock x:Name="BlurToText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="Set to current" Click="OnBlurTo"/>
                                </Grid>
                                <Button Content="Blur on all frames" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OnBlurAll"/>
                            </StackPanel>
                            <TextBlock x:Name="BlurHint" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Hide part of the GIF. Drag a blur box on the preview to move it, the corner to resize. Click &apos;Done&apos; to finalize each blur. Up to 10 blur boxes."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Crop"/>
                            <ComboBox x:Name="CropCombo" SelectionChanged="OnCropPreset"/>
                            <TextBlock x:Name="CropText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Pick a shape, then drag the box to choose what stays."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Export GIF"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LoopCombo"/>
                                <ComboBox x:Name="QualityCombo" Grid.Column="2">
                                    <ComboBoxItem Content="Best quality" IsSelected="True"/>
                                    <ComboBoxItem Content="Smaller file"/>
                                </ComboBox>
                            </Grid>
                            <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Content="Save GIF…" Margin="0,10,0,0" Padding="10,7"
                                    Click="OnExport"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ExportProgress" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" IsEnabled="False" Click="OnCancel"/>
                            </Grid>
                            <TextBlock x:Name="ExportText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                                       Text="Common limits: Discord 10 MB, X (Twitter) 15 MB."/>
                            <Button x:Name="ShowFileButton" Content="Show in folder" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Visibility="Collapsed" Click="OnShowFile"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Frame strip ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="Strip" Height="132" SelectionMode="Extended" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnStripSelection" KeyDown="OnStripKey">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2" Width="112">
                            <Border Background="#111318" Height="72" CornerRadius="3">
                                <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                            </Border>
                            <DockPanel Margin="2,3,2,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DelayText}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold"/>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ===== Loading overlay ===== -->
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#CCF3F4F6" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <TextBlock x:Name="LoadingText" Text="Loading frames…" FontSize="16" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="LoadingProgress" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="1"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
