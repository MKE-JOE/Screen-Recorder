<UserControl x:Class="ScreenRecorder.Controls.TransportControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The video navigation buttons shared by the main window and both editors. -->
    <StackPanel Orientation="Horizontal">
        <Button x:Name="StartButton" Style="{StaticResource TransportButton}" ToolTip="Jump to clip start" Click="OnStart">
            <Path Style="{StaticResource Icon}" Data="M0,0 H2.5 V12 H0 Z M12,0 L3.5,6 L12,12 Z"/>
        </Button>
        <RepeatButton x:Name="RewindButton" Style="{StaticResource TransportButton}" ToolTip="Rewind 5 seconds (hold to scan)"
                      Delay="400" Interval="150" Click="OnRewind">
            <Path Style="{StaticResource Icon}" Data="M14,0 L7,6 L14,12 Z M7,0 L0,6 L7,12 Z"/>
        </RepeatButton>
        <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" ToolTip="Play" Click="OnPlay">
            <Path Style="{StaticResource Icon}" Data="M0,0 L10,6 L0,12 Z" Margin="3,0,0,0"/>
        </Button>
        <Button x:Name="PauseButton" Style="{StaticResource TransportButton}" ToolTip="Pause" Click="OnPause">
            <Path Style="{StaticResource Icon}" Data="M0,0 H3.5 V12 H0 Z M6.5,0 H10 V12 H6.5 Z"/>
        </Button>
        <Button x:Name="StopButton" Style="{StaticResource TransportButton}" ToolTip="Stop" Click="OnStop">
            <Path Style="{StaticResource Icon}" Data="M0,0 H10 V10 H0 Z" Width="14" Height="14"/>
        </Button>
        <RepeatButton x:Name="ForwardButton" Style="{StaticResource TransportButton}" ToolTip="Fast-forward 5 seconds (hold to scan)"
                      Delay="400" Interval="150" Click="OnForward">
            <Path Style="{StaticResource Icon}" Data="M0,0 L7,6 L0,12 Z M7,0 L14,6 L7,12 Z"/>
        </RepeatButton>
        <Button x:Name="EndButton" Style="{StaticResource TransportButton}" ToolTip="Jump to clip end" Click="OnEnd">
            <Path Style="{StaticResource Icon}" Data="M0,0 L8.5,6 L0,12 Z M9.5,0 H12 V12 H9.5 Z"/>
        </Button>
    </StackPanel>
</UserControl>
