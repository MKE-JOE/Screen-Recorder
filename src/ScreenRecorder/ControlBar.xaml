<Window x:Class="ScreenRecorder.ControlBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Recorder controls" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False">
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarIcon" TargetType="Path">
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE111827" CornerRadius="21" Padding="6,4" Margin="6" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <!-- drag grip -->
            <Path Data="M0,0 h2 v2 h-2 Z M4,0 h2 v2 h-2 Z M0,4 h2 v2 h-2 Z M4,4 h2 v2 h-2 Z M0,8 h2 v2 h-2 Z M4,8 h2 v2 h-2 Z"
                  Fill="#9CA3AF" Width="7" Height="12" Stretch="Uniform" Margin="6,0,6,0" VerticalAlignment="Center"
                  Cursor="SizeAll" ToolTip="Drag to move"/>
            <Button x:Name="RecordBtn" Style="{StaticResource BarButton}" ToolTip="Record" Click="OnRecord">
                <Ellipse Width="14" Height="14" Fill="#E5484D"/>
            </Button>
            <Button x:Name="PauseBtn" Style="{StaticResource BarButton}" ToolTip="Pause / resume" Click="OnPause">
                <Path Style="{StaticResource BarIcon}" Data="M0,0 H3.5 V12 H0 Z M6.5,0 H10 V12 H6.5 Z"/>
            </Button>
            <Button x:Name="StopBtn" Style="{StaticResource BarButton}" ToolTip="Stop and save" Click="OnStop">
                <Path Style="{StaticResource BarIcon}" Data="M0,0 H10 V10 H0 Z" Width="11" Height="11"/>
            </Button>
            <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#E5484D" Margin="8,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="TimeText" Text="Ready" Foreground="White" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" MinWidth="64" Margin="6,0,6,0"/>
            <Rectangle Width="1" Fill="#4B5563" Margin="2,6"/>
            <Button Style="{StaticResource BarButton}" ToolTip="Show the main window" Click="OnShowApp">
                <Path Style="{StaticResource BarIcon}" Fill="Transparent" Stroke="White" StrokeThickness="1.6"
                      Data="M0,0 H12 V9 H0 Z M0,2.5 H12"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
